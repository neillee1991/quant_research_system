# ===================================================================
# 量化研究系统 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ===================================================================

# ==================== 数据源配置 ====================

# Tushare API Token（必填，用于数据同步）
# 获取地址: https://tushare.pro/register
TUSHARE_TOKEN=your_tushare_token_here

# API 限流配置（每分钟调用次数）
COLLECTOR__CALLS_PER_MINUTE=120

# ==================== DolphinDB 配置 ====================

# DolphinDB 连接信息
DOLPHINDB_HOST=localhost
DOLPHINDB_PORT=8848
DOLPHINDB_USER=admin
DOLPHINDB_PASSWORD=           # 必填，DolphinDB 登录密码
DOLPHINDB_DB_PATH=dfs://quant

# DolphinDB Docker 数据目录（必填，建议使用项目外独立目录）
DOLPHINDB_DATA_DIR=/data/dolphindb

# ==================== PostgreSQL 配置 ====================

# PostgreSQL 连接信息
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quantsystem
POSTGRES_USER=quant
POSTGRES_PASSWORD=            # 必填，PostgreSQL 登录密码（docker-compose 同步使用此值）

# PostgreSQL Docker 数据目录
POSTGRES_DATA_DIR=/data/postgres

# Timezone configuration
TZ=Asia/Shanghai

# ==================== 回测配置 ====================

# 初始资金（元）
BACKTEST__INITIAL_CAPITAL=1000000

# 手续费率
BACKTEST__COMMISSION_RATE=0.0003

# 滑点率
BACKTEST__SLIPPAGE_RATE=0.0001

# ==================== 应用配置 ====================

# 运行环境 (development/production)
ENVIRONMENT=development

# 调试模式
DEBUG=false

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# ==================== 前端配置 ====================

# API 基础地址
REACT_APP_API_BASE_URL=http://localhost:8000

# ==================== 网络配置 ====================

# CORS 允许的源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
