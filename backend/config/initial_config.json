      {
        "task_id": "etl_index_member",
        "description": "合并申万+中信行业成员表（当前有效分类）",
        "script": "t_sw = select l1_code, l1_name, l2_code, l2_name, l3_code, l3_name, ts_code, in_date, out_date, \"sw\" as source from loadTable(\"dfs://quant\", \"sync_sw_index_member_Y\"); \nt_ci = select l1_code, l1_name, l2_code, l2_name, l3_code, l3_name, ts_code, in_date, out_date, \"ci\" as source from loadTable(\"dfs://quant\", \"sync_ci_index_member_Y\"); \nunionAll([t_sw, t_ci], false);\n",
        "sync_type": "full",
        "date_field": "",
        "primary_keys": [],
        "table_name": "etl_index_member",
        "enabled": true,
        "schema": {"l1_code": {"type": "STRING"}, "l1_name": {"type": "STRING"}, "l2_code": {"type": "STRING"}, "l2_name": {"type": "STRING"}, "l3_code": {"type": "STRING"}, "l3_name": {"type": "STRING"}, "ts_code": {"type": "SYMBOL"}, "in_date": {"type": "DATE"}, "out_date": {"type": "DATE"}, "source": {"type": "STRING"}}
      },
      {
        "task_id": "etl_index_member_daily",
        "description": "每只股票每个交易日所属行业（行情左关联行业成员）",
        "script": "daily = select trade_date, ts_code \nfrom loadTable(\"dfs://quant\", \"sync_daily_data\")\nwhere trade_date={date};\n\netl = select ts_code, source, l1_code, l1_name, l2_code, l2_name, l3_code, l3_name, in_date, out_date \nfrom loadTable(\"dfs://quant\", \"etl_index_member\")\nwhere source='sw'; \n\njoined = lj(daily, etl, `ts_code); \n\nselect trade_date, ts_code, l1_name,l2_name\nfrom joined \nwhere (isNull(in_date) or trade_date >= in_date )\nand (isNull(out_date) or trade_date < out_date)",
        "sync_type": "incremental",
        "date_field": "trade_date",
        "primary_keys": [],
        "table_name": "etl_index_member_daily",
        "enabled": true,
        "schema": {"trade_date": {"type": "DATE"}, "ts_code": {"type": "SYMBOL"}, "l1_name": {"type": "STRING"}, "l2_name": {"type": "STRING"}}
      }
    ],
    "factor_configs": [
      {
        "factor_id": "factor_pb_rank",
        "description": "PB百分位排名（截面，0~1）",
        "category": "value",
        "compute_mode": "incremental",
        "storage_target": "factor_values",
        "depends_on": "[\"etl_stock_daily_info\", \"sync_daily_basic\"]",
        "params": "{\"preprocess\": {\"adjust_price\": \"forward\", \"filter_st\": true, \"filter_new_stock\": true, \"new_stock_days\": 60, \"mark_limit\": true, \"handle_suspension\": true}, \"lookback_days\": 1}",
        "code": "import polars as pl\ndef compute(df, params):\n    return (\n        df.sort(['trade_date', 'ts_code'])\n        .with_columns(\n            pl.col('pb').rank(method='average').over('trade_date','l1_name').alias('_rank'),\n            pl.col('pb').count().over('trade_date','l1_name').alias('_total'),\n        )\n        .with_columns(\n            (pl.col('_rank') / pl.col('_total')).alias('factor_value')\n        )\n        .select(['ts_code', 'trade_date', 'factor_value'])\n    )\n",
        "enabled": true,
        "align_calendar": false
      },
      {
        "factor_id": "factor_ma_20",
        "description": "20日移动平均线",
        "category": "technical",
        "compute_mode": "incremental",
        "storage_target": "factor_values",
        "depends_on": "[\"sync_daily_data\"]",
        "params": "{\"window\": 20}",
        "code": "import polars as pl\ndef compute(df, params):\n    window = params.get('window', 20)\n    return (\n        df.sort(['ts_code', 'trade_date'])\n        .with_columns(\n            pl.col('close').rolling_mean(window_size=window)\n            .over('ts_code')\n            .alias('factor_value')\n        )\n        .select(['ts_code', 'trade_date', 'factor_value'])\n    )\n",
        "enabled": true,
        "align_calendar": false
      },
      {
        "factor_id": "factor_volatility_10",
        "description": "10日收益率波动率（年化）",
        "category": "technical",
        "compute_mode": "incremental",
        "storage_target": "factor_values",
        "depends_on": "[\"sync_daily_data\"]",
        "params": "{\"window\": 10, \"preprocess\": {\"adjust_price\": \"forward\", \"filter_st\": true, \"filter_new_stock\": true, \"new_stock_days\": 60, \"mark_limit\": true}, \"lookback_days\": 10}",
        "code": "import polars as pl\ndef compute(df, params):\n    window = params.get('window', 10)\n    return (\n        df.sort(['ts_code', 'trade_date'])\n        .with_columns(\n            pl.col('close').pct_change().over('ts_code').alias('ret')\n        )\n        .with_columns(\n            (pl.col('ret').rolling_std(window_size=window).over('ts_code') * (252 ** 0.5))\n            .alias('factor_value')\n        )\n        .select(['ts_code', 'trade_date', 'factor_value'])\n    )\n",
        "enabled": true,
        "align_calendar": false
      },
      {
        "factor_id": "factor_volatility_20",
        "description": "20日收益率波动率（年化）",
        "category": "technical",
        "compute_mode": "incremental",
        "storage_target": "factor_values",
        "depends_on": "[\"sync_daily_data\"]",
        "params": "{\"window\": 20, \"preprocess\": {\"adjust_price\": \"forward\", \"filter_st\": true, \"filter_new_stock\": true, \"new_stock_days\": 60, \"mark_limit\": true}, \"lookback_days\": 20}",
        "code": "import polars as pl\ndef compute(df, params):\n    window = params.get('window', 20)\n    return (\n        df.sort(['ts_code', 'trade_date'])\n        .with_columns(\n            pl.col('close').pct_change().over('ts_code').alias('ret')\n        )\n        .with_columns(\n            (pl.col('ret').rolling_std(window_size=window).over('ts_code') * (252 ** 0.5))\n            .alias('factor_value')\n        )\n        .select(['ts_code', 'trade_date', 'factor_value'])\n    )\n",
        "enabled": true,
        "align_calendar": false
      }
