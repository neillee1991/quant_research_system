        return [
            {
                "factor_id": "factor_ma_20",
                "description": "20日移动平均线",
                "category": "technical",
                "compute_mode": "incremental",
                "storage_target": "factor_values",
                "depends_on": ["sync_daily_data"],
                "params": {"window": 20},
                "code": (
                    "import polars as pl
def compute(df, params):
    window = params.get('window', 20)
    return (
        df.sort(['ts_code', 'trade_date'])
        .with_columns(
            pl.col('close').rolling_mean(window_size=window)
            .over('ts_code').alias('factor_value')
        )
        .select(['ts_code', 'trade_date', 'factor_value'])
    )
"
