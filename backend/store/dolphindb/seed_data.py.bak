    def _get_default_etl_tasks(self) -> list[dict]:
        """获取默认 ETL 任务配置"""
        return [
            {
                "task_id": "etl_index_member",
                "description": "合并申万+中信行业成员表（当前有效分类）",
                "script": (
                    't_ci_y = select l1_code, l1_name, l2_code, l2_name, l3_code, l3_name,
                ts_code, name, in_date, out_date, is_new, "ci" as source
         from loadTable("dfs://quant", "sync_ci_index_member_Y")

t_ci_n = select l1_code, l1_name, l2_code, l2_name, l3_code, l3_name,
                ts_code, name, in_date, out_date, is_new, "ci" as source
         from loadTable("dfs://quant", "sync_ci_index_member_N")

t_sw_y = select l1_code, l1_name, l2_code, l2_name, l3_code, l3_name,
                ts_code, name, in_date, out_date, is_new, "sw" as source
         from loadTable("dfs://quant", "sync_sw_index_member_Y")

t_sw_n = select l1_code, l1_name, l2_code, l2_name, l3_code, l3_name,
                ts_code, name, in_date, out_date, is_new, "sw" as source
         from loadTable("dfs://quant", "sync_sw_index_member_N")

select source,is_new,ts_code,l1_name,l2_name,in_date,out_date 
from unionAll([t_ci_y, t_ci_n, t_sw_y, t_sw_n], false)'
                ),
                "sync_type": "full",
                "date_field": "",
                "table_name": "etl_index_member",
                "primary_keys": [],
                "schema": {},
            },
            {
                "task_id": "etl_index_member_daily",
                "description": "每只股票每个交易日所属行业（行情左关联行业成员）",
                "script": (
                    'daily = select trade_date, ts_code
        from loadTable("dfs://quant", "sync_daily_data")
        where trade_date={date};

etl = select ts_code, source,  l1_name,  l2_name, 
             in_date, case when out_date is null then {date} else out_date end as out_date
      from loadTable("dfs://quant", "etl_index_member")
      where source =\'sw\';

joined = lj(daily, etl, `ts_code);


select trade_date, ts_code,  l1_name,  l2_name
from joined
where trade_date >= in_date and trade_date <=out_date
'
                ),
                "sync_type": "incremental",
                "date_field": "trade_date",
                "table_name": "etl_index_member_daily",
                "primary_keys": [],
                "schema": {},
            },
            {
                "task_id": "etl_stock_daily_info",
                "description": "行情+基本面+行业宽表（每日全量刷新）",
                "script": (
                    '
db = database("dfs://quant")
daily    = SELECT ts_code, trade_date, close FROM loadTable(db, "sync_daily_data") WHERE trade_date =  {date} ;

st_codes = exec ts_code FROM loadTable(db, "sync_stock_st") WHERE trade_date =  {date} ;

sus_full = exec ts_code FROM loadTable(db, "sync_suspend_d") WHERE trade_date =  {date}  AND suspend_type = "S" AND strlen(suspend_timing) == 0;

sus_part = exec ts_code FROM loadTable(db, "sync_suspend_d") WHERE trade_date =  {date}  AND suspend_type = "S" AND strlen(suspend_timing) > 0;

lim = SELECT ts_code, trade_date, up_limit, down_limit FROM loadTable(db, "sync_stk_limit") WHERE trade_date =  {date} ;

t = lj(daily, lim, `ts_code);

price_info = SELECT ts_code, trade_date, iif(ts_code IN st_codes, 1, 0) AS is_st, iif(ts_code IN sus_full, 1, iif(ts_code IN sus_part, 2, 0)) AS is_suspend, iif(isNull(up_limit), 0, iif(close >= up_limit, 1, iif(close <= down_limit, -1, 0))) AS is_limit FROM t


industry=SELECT * FROM loadTable("dfs://quant", "etl_index_member_daily") WHERE trade_date= {date} ;

select ts_code,trade_date,is_st,is_suspend,is_limit,l1_name,l2_name
from lj(price_info, industry, `ts_code);




'
                ),
                "sync_type": "incremental",
                "date_field": "trade_date",
                "table_name": "etl_stock_daily_info",
                "primary_keys": [],
                "schema": {},
            },
        ],
                "table_name": "etl_index_member",
                "source_tables": ["sync_sw_index_member_Y", "sync_ci_index_member_Y"],
            },
            {
                "task_id": "etl_index_member_daily",
                "description": "每只股票每个交易日所属行业（行情左关联行业成员）",
                "script": script_index_member_daily,
                "sync_type": "full",
                "date_field": "trade_date",
                "primary_keys": ["trade_date", "ts_code", "source", "l3_code"],
                "table_name": "etl_index_member_daily",
                "source_tables": ["sync_daily_data", "etl_index_member"],
            },
            {
                "task_id": "etl_stock_daily_info",
                "description": "行情+基本面+行业宽表（每日全量刷新）",
                "script": script_stock_daily_info,
                "sync_type": "full",
                "date_field": "trade_date",
                "primary_keys": ["trade_date", "ts_code", "source"],
                "table_name": "etl_stock_daily_info",
                "source_tables": ["sync_daily_data", "sync_daily_basic", "etl_index_member_daily"],
            },
        ]

