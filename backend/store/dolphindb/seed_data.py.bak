            {
                "factor_id": "factor_momentum_20",
                "description": "20日价格动量（当日收盘价 / 20日前收盘价 - 1）",
                "category": "momentum",
                "compute_mode": "incremental",
                "storage_target": "factor_values",
                "depends_on": ["sync_daily_data"],
                "params": {"window": 20},
                "code": (
                    "import polars as pl
def compute(df, params):
    window = params.get('window', 20)
    return (
        df.sort(['ts_code', 'trade_date'])
        .with_columns(
            (pl.col('close') / pl.col('close').shift(window).over('ts_code') - 1)
            .alias('factor_value')
        )
        .select(['ts_code', 'trade_date', 'factor_value'])
    )
"
                ),
            },
            {
                "factor_id": "factor_pb_rank",
                "description": "PB百分位排名（截面，0~1）",
                "category": "value",
                "compute_mode": "incremental",
                "storage_target": "factor_values",
                "depends_on": ["sync_daily_basic"],
                "params": {},
                "code": (
                    "import polars as pl
def compute(df, params):
    return (
        df.sort(['trade_date', 'ts_code'])
        .with_columns(
            pl.col('pb').rank(method='average').over('trade_date').alias('_rank'),
            pl.col('pb').count().over('trade_date').alias('_total'),
        )
        .with_columns(
            (pl.col('_rank') / pl.col('_total')).alias('factor_value')
        )
        .select(['ts_code', 'trade_date', 'factor_value'])
    )
"
                ),
            },
            {
                "factor_id": "factor_pe_rank",
                "description": "PE百分位排名（截面，0~1）",
                "category": "value",
                "compute_mode": "incremental",
                "storage_target": "factor_values",
                "depends_on": ["sync_daily_basic"],
                "params": {},
                "code": (
                    "import polars as pl
def compute(df, params):
    return (
        df.sort(['trade_date', 'ts_code'])
        .with_columns(
            pl.col('pe_ttm').rank(method='average').over('trade_date').alias('_rank'),
            pl.col('pe_ttm').count().over('trade_date').alias('_total'),
        )
        .with_columns(
            (pl.col('_rank') / pl.col('_total')).alias('factor_value')
        )
        .select(['ts_code', 'trade_date', 'factor_value'])
    )
"
                ),
            },
            {
                "factor_id": "factor_rsi_14",
                "description": "14日相对强弱指数（RSI，Wilder EWM法）",
                "category": "technical",
                "compute_mode": "incremental",
                "storage_target": "factor_values",
                "depends_on": ["sync_daily_data"],
                "params": {"window": 14},
                "code": (
                    "import polars as pl
def compute(df, params):
    window = params.get('window', 14)
    alpha = 1.0 / window
    return (
        df.sort(['ts_code', 'trade_date'])
        .with_columns(
            pl.col('close').diff().over('ts_code').alias('delta')
        )
        .with_columns(
            pl.when(pl.col('delta') > 0).then(pl.col('delta')).otherwise(0.0).alias('gain'),
            pl.when(pl.col('delta') < 0).then(-pl.col('delta')).otherwise(0.0).alias('loss'),
        )
        .with_columns(
            pl.col('gain').ewm_mean(alpha=alpha, adjust=False).over('ts_code').alias('avg_gain'),
            pl.col('loss').ewm_mean(alpha=alpha, adjust=False).over('ts_code').alias('avg_loss'),
        )
        .with_columns(
            (100.0 - 100.0 / (1.0 + pl.col('avg_gain') / (pl.col('avg_loss') + 1e-10)))
            .alias('factor_value')
        )
        .select(['ts_code', 'trade_date', 'factor_value'])
    )
"
                ),
            },
            {
                "factor_id": "factor_volatility_10",
                "description": "10日收益率波动率（年化）",
                "category": "technical",
                "compute_mode": "incremental",
                "storage_target": "factor_values",
                "depends_on": ["sync_daily_data"],
                "params": {"window": 10},
                "code": (
                    "import polars as pl
def compute(df, params):
    window = params.get('window', 10)
    return (
        df.sort(['ts_code', 'trade_date'])
        .with_columns(
            pl.col('close').pct_change().over('ts_code').alias('ret')
        )
        .with_columns(
            (pl.col('ret').rolling_std(window_size=window).over('ts_code') * (252 ** 0.5))
            .alias('factor_value')
        )
        .select(['ts_code', 'trade_date', 'factor_value'])
    )
"
