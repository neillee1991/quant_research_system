// ============================================================
// 迁移脚本：factor_analysis_extended 表使用 UUID 作为 ID
// 将 id 列从 INT 改为 SYMBOL，使用 UUID 避免冲突
// 创建日期: 2026-03-21
// ============================================================

login("admin", "123456")
db = database("dfs://quant")

// 1. 备份当前数据
if (existsTable("dfs://quant", "factor_analysis_extended")) {
    old_data = select * from loadTable("dfs://quant", "factor_analysis_extended")
    print("备份当前数据，共 " + string(size(old_data)) + " 条记录")

    // 删除旧表
    dropTable(db, "factor_analysis_extended")
    print("✓ 已删除旧表 factor_analysis_extended")
} else {
    print("⚠ 表不存在，直接创建新表")
    old_data = NULL
}

// 2. 创建新表结构（id 改为 SYMBOL，用于存储 UUID）
schema_analysis = table(
    array(SYMBOL, 0) as id,              // 改为 SYMBOL，存储 UUID
    array(SYMBOL, 0) as factor_id,
    array(TIMESTAMP, 0) as analysis_date,
    array(DATE, 0) as start_date,
    array(DATE, 0) as end_date,

    // 配置和摘要指标（DB 存储，用于列表展示和跨因子比较）
    array(STRING, 0) as config,
    array(STRING, 0) as ic_summary,
    array(STRING, 0) as ic_by_period,
    array(STRING, 0) as decay_analysis,

    // 完整报告文件路径（详情页从文件加载）
    array(STRING, 0) as report_path,

    // 任务状态
    array(SYMBOL, 0) as task_status,
    array(STRING, 0) as task_id,           // 保留 task_id 字段作为冗余
    array(STRING, 0) as error_message
)

db.createTable(schema_analysis, "factor_analysis_extended", sortColumns=["factor_id", "analysis_date"])
print("✓ 已创建新表 factor_analysis_extended (id 字段为 SYMBOL 类型，存储 UUID)")

// 3. 恢复备份数据（如果有）
if (old_data !== NULL && size(old_data) > 0) {
    // 为旧数据生成 UUID
    // 注意：旧数据可能没有 id，或者 id 是数字，我们需要转换
    if (hasColumn(old_data, "id")) {
        // 将数字 id 转换为字符串，或者生成新的 UUID
        // 这里我们直接把旧 id 转成字符串作为兼容处理
        old_data = select *, string(id) as id_str from old_data
        old_data = select id_str as id, factor_id, analysis_date, start_date, end_date,
                            config, ic_summary, ic_by_period, decay_analysis,
                            report_path, task_status, task_id, error_message
                      from old_data
    }
    loadTable("dfs://quant", "factor_analysis_extended").append!(old_data)
    print("✓ 已恢复 " + string(size(old_data)) + " 条记录")
}

print("========================================")
print("迁移完成！")
print("  ✓ id 字段改为 SYMBOL 类型")
print("  ✓ 使用 UUID 作为任务标识，避免冲突")
print("========================================")
