// ============================================================
// 因子运行日志表迁移脚本
// 创建日期: 2026-03-14
// 说明: 添加 factor_run_log 表用于记录因子计算任务的执行日志
// ============================================================

// 登录
try { login("admin", "123456") } catch(ex) { /* 已通过 session 登录 */ }

// 获取数据库句柄
db = database("dfs://quant")

// ==================== factor_run_log 因子运行日志表 ====================
// 维度表（不分区）- 记录每次因子计算任务的执行情况
if (!existsTable("dfs://quant", "factor_run_log")) {
    schema_run_log = table(
        array(SYMBOL, 0) as run_id,
        array(SYMBOL, 0) as factor_id,
        array(DATE, 0) as start_date,
        array(DATE, 0) as end_date,
        array(SYMBOL, 0) as mode,
        array(SYMBOL, 0) as status,
        array(INT, 0) as rows,
        array(DOUBLE, 0) as elapsed_seconds,
        array(STRING, 0) as message,
        array(TIMESTAMP, 0) as created_at,
        array(TIMESTAMP, 0) as finished_at
    )
    db.createTable(schema_run_log, "factor_run_log", sortColumns=["factor_id", "created_at"])
    print("✓ 已创建表 factor_run_log (因子运行日志)")
} else {
    print("⚠ 表 factor_run_log 已存在，跳过")
}

print("========================================")
print("因子运行日志表迁移完成!")
print("  ✓ factor_run_log (因子运行日志表)")
print("========================================")
