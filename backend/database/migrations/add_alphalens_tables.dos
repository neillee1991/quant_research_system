// ============================================================
// Alphalens 集成 DolphinDB 数据库迁移脚本
// 创建日期: 2026-03-03
// 说明: 添加指数股票池表、指数元数据表、因子分析结果扩展表
// ============================================================

// 登录
try { login("admin", "123456") } catch(ex) { /* 已通过 session 登录 */ }

// 获取数据库句柄
db = database("dfs://quant")

// ==================== 1. index_constituents 指数成分股表 ====================
// 分区表：按 trade_date 和 ts_code 分区
if (!existsTable("dfs://quant", "index_constituents")) {
    schema_constituents = table(
        array(DATE, 0) as trade_date,
        array(SYMBOL, 0) as ts_code,
        array(SYMBOL, 0) as index_code,
        array(DOUBLE, 0) as weight,
        array(TIMESTAMP, 0) as created_at,
        array(TIMESTAMP, 0) as updated_at
    )
    createPartitionedTable(
        dbHandle=db,
        table=schema_constituents,
        tableName="index_constituents",
        partitionColumns=["trade_date", "ts_code"],
        sortColumns=["index_code", "ts_code", "trade_date"],
        keepDuplicates=LAST
    )
    print("✓ 已创建表 index_constituents (指数成分股)")
} else {
    print("⚠ 表 index_constituents 已存在，跳过")
}

// ==================== 2. index_metadata 指数元数据表 ====================
// 维度表（不分区）- TSDB 引擎需要指定 sortColumns
if (!existsTable("dfs://quant", "index_metadata")) {
    schema_metadata = table(
        array(SYMBOL, 0) as index_code,
        array(STRING, 0) as index_name,
        array(STRING, 0) as description,
        array(INT, 0) as stock_count,
        array(DATE, 0) as latest_date,
        array(TIMESTAMP, 0) as created_at,
        array(TIMESTAMP, 0) as updated_at
    )
    db.createTable(schema_metadata, "index_metadata", sortColumns=["index_code", "updated_at"])
    print("✓ 已创建表 index_metadata (指数元数据)")
} else {
    print("⚠ 表 index_metadata 已存在，跳过")
}

// ==================== 3. factor_analysis_extended 因子分析结果扩展表 ====================
// 维度表（不分区）- 存储 Alphalens 分析结果，TSDB 引擎需要指定 sortColumns
if (!existsTable("dfs://quant", "factor_analysis_extended")) {
    schema_analysis = table(
        array(INT, 0) as id,
        array(SYMBOL, 0) as factor_id,
        array(TIMESTAMP, 0) as analysis_date,
        array(DATE, 0) as start_date,
        array(DATE, 0) as end_date,

        // JSON 字段在 DolphinDB 中使用 STRING 类型存储
        array(STRING, 0) as config,
        array(STRING, 0) as ic_summary,
        array(STRING, 0) as ic_by_period,
        array(STRING, 0) as ic_ts,
        array(STRING, 0) as quantile_returns,
        array(STRING, 0) as cumulative_returns,
        array(STRING, 0) as ic_by_group,
        array(STRING, 0) as returns_by_group,
        array(STRING, 0) as turnover,
        array(STRING, 0) as decay_analysis,
        array(STRING, 0) as charts_data,

        // 任务状态
        array(SYMBOL, 0) as task_status,
        array(STRING, 0) as task_id,
        array(STRING, 0) as error_message
    )
    db.createTable(schema_analysis, "factor_analysis_extended", sortColumns=["factor_id", "analysis_date"])
    print("✓ 已创建表 factor_analysis_extended (因子分析结果扩展)")
} else {
    print("⚠ 表 factor_analysis_extended 已存在，跳过")
}

// ==================== 4. 初始化 factor_data_config 配置 ====================
// 检查 factor_data_config 表是否存在
if (existsTable("dfs://quant", "factor_data_config")) {
    // 检查是否已有 industry 和 market_cap 配置
    existing_config = select * from loadTable("dfs://quant", "factor_data_config") where field_key in ["industry", "market_cap"]

    if (size(existing_config) == 0) {
        // 插入默认配置
        config_data = table(
            ["industry", "market_cap"] as field_key,
            ["行业分类", "市值"] as description,
            ["", ""] as table_name,
            ["", ""] as column_name,
            ['{"mode": "to_be_configured", "note": "请配置行业字段的数据源（如申万行业、中信行业等）"}',
             '{"mode": "to_be_configured", "note": "请配置市值字段的数据源（总市值或流通市值）"}'] as extra_config,
            [now(), now()] as updated_at
        )

        loadTable("dfs://quant", "factor_data_config").append!(config_data)
        print("✓ 已插入 factor_data_config 配置项 (industry, market_cap)")
    } else {
        print("⚠ factor_data_config 配置项已存在，跳过")
    }
} else {
    print("⚠ 表 factor_data_config 不存在，将由后端应用创建")
}

print("========================================")
print("Alphalens 集成数据库迁移完成!")
print("  ✓ index_constituents (指数成分股表)")
print("  ✓ index_metadata (指数元数据表)")
print("  ✓ factor_analysis_extended (因子分析结果扩展表)")
print("========================================")
